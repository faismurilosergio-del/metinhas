  document.getElementById('g-mtype').addEventListener('change', (e)=>{
    document.getElementById('g-target-wrap').style.display = e.target.value==='boolean' ? 'none' : '';
  });
  document.getElementById('g-ptype').addEventListener('change', (e)=>{
    ['g-p-days','g-p-weekcount','g-p-monthcount','g-p-interval'].forEach(id=>document.getElementById(id).style.display='none');
    const map={weekly_days:'g-p-days', weekly_count:'g-p-weekcount', monthly_count:'g-p-monthcount', custom_interval:'g-p-interval'};
    if(map[e.target.value]) document.getElementById(map[e.target.value]).style.display='';
  });

  document.getElementById('g-save').onclick = async ()=>{
    const title = document.getElementById('g-title').value.trim();
    if(!title){ alert('Dê um nome para a meta.'); return; }
