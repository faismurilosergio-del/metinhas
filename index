function renderAgenda(){
  document.getElementById('dateLabel').textContent = state.currentDate===todayStr() ? `Hoje · ${fmtDatePt(state.currentDate)}` : fmtDatePt(state.currentDate);
  document.getElementById('dateFwd').disabled = state.currentDate >= todayStr();

  const dateStr = state.currentDate;
  const dayRecords = state.records.filter(r=>r.date===dateStr);

  // resumo
  const summaryEl = document.getElementById('agendaSummary');
  const summaryFor = (pid)=>{
    const recs = dayRecords.filter(r=>r.personId===pid || (pid!=='both' && r.personId==='both'));
    const relevant = dayRecords.filter(r=> r.personId===pid );
    const total = relevant.length;
    const done = relevant.filter(r=>r.status==='completed').length;
    const pct = total? Math.round(done/total*100) : 0;
    return {total, done, pct};
  };
  const s1=summaryFor('p1'), s2=summaryFor('p2');
  summaryEl.innerHTML = `
    <div class="stat-grid">
      <div class="stat-card">
        <div class="flex-between"><strong>${personEmoji('p1')} ${personLabel('p1')}</strong><span class="muted">${s1.done}/${s1.total}</span></div>
        <div class="progress-track" style="margin-top:8px;"><div class="progress-fill p1" style="width:${s1.pct}%"></div></div>
      </div>
      <div class="stat-card">
        <div class="flex-between"><strong>${personEmoji('p2')} ${personLabel('p2')}</strong><span class="muted">${s2.done}/${s2.total}</span></div>
        <div class="progress-track" style="margin-top:8px;"><div class="progress-fill p2" style="width:${s2.pct}%"></div></div>
      </div>
    </div>`;

  const listsEl = document.getElementById('agendaLists');
  const groups = [
    {key:'p1', label:personLabel('p1'), emoji:personEmoji('p1')},
    {key:'p2', label:personLabel('p2'), emoji:personEmoji('p2')},
    {key:'both', label:'Metas do casal', emoji:'❤️'},
  ];
  let html='';
  for(const g of groups){
    const recs = dayRecords.filter(r=>r.personId===g.key).sort((a,b)=>a.goalTitle.localeCompare(b.goalTitle));
    if(recs.length===0) continue;
    html += `<div class="person-band ${g.key==='both'?'couple':g.key}"><div class="avatar">${g.emoji}</div><strong>${g.label}</strong></div>`;
    for(const r of recs){
      html += renderRecordRow(r);
    }
  }
  if(!html){
    html = `<div class="empty-state"><span class="em">🌤️</span>Nenhuma meta para este dia.<br><span class="muted">Crie metas na aba Metas para começar.</span></div>`;
  }
  listsEl.innerHTML = html;

  // wire actions
  listsEl.querySelectorAll('[data-complete]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const rec = state.records.find(r=>r.id===btn.dataset.complete);
      if(rec.measurementType && rec.measurementType!=='boolean'){
        const input = listsEl.querySelector(`[data-valinput="${rec.id}"]`);
        completeRecord(rec, input ? input.value : null);
      } else {
        completeRecord(rec, null);
      }
    });
  });
  listsEl.querySelectorAll('[data-fail]').forEach(btn=>{
    btn.addEventListener('click', ()=>failRecord(state.records.find(r=>r.id===btn.dataset.fail)));
  });
  listsEl.querySelectorAll('[data-skip]').forEach(btn=>{
    btn.addEventListener('click', ()=>skipRecord(state.records.find(r=>r.id===btn.dataset.skip)));
  });
}
function renderRecordRow(r){
  const goal = state.goals.find(g=>g.id===r.goalId);
  const isToday = r.date===todayStr();
  const canAct = isToday && r.status==='pending';
  const moneyLine = `${(r.rewardSnapshot>0)?`<span class="rw">+${fmtMoney(r.rewardSnapshot).replace('R$ ','R$')}</span>`:''}${(r.penaltySnapshot>0)?`<span class="pn">-${fmtMoney(r.penaltySnapshot).replace('R$ ','R$')}</span>`:''}`;
  let actions='';
  if(canAct){
    if(r.measurementType && r.measurementType!=='boolean'){
      actions = `
        <div class="value-entry">
          <input type="number" step="any" data-valinput="${r.id}" placeholder="${r.targetValue?('meta: '+r.targetValue):''}">
          <span class="muted">${r.unit||''}</span>
        </div>
        <button class="btn btn-success btn-sm" data-complete="${r.id}">Registrar</button>
        <button class="btn btn-ghost btn-sm" data-skip="${r.id}">Pular</button>
      `;
    } else {
      actions = `
        <button class="btn btn-success btn-sm" data-complete="${r.id}">✔ Concluir</button>
        <button class="btn btn-danger btn-sm" data-fail="${r.id}">✕ Não cumprir</button>
        <button class="btn btn-ghost btn-sm" data-skip="${r.id}">Pular</button>
      `;
    }
  } else {
    const labelMap={completed:'Concluída', failed:'Não cumprida', skipped:'Pulada', expired:'Expirada', pending:'Pendente'};
    actions = `<span class="status-badge ${r.status}">${labelMap[r.status]||r.status}</span>`;
    if(r.status==='completed' && r.measuredValue!=null && r.targetValue){
      actions += ` <span class="muted">${r.measuredValue}/${r.targetValue} ${r.unit||''}</span>`;
    }
  }
  const streakTxt = (()=>{
    if(!goal || r.personId==='both') return '';
    const st = computeStreak(r.goalId, r.personId);
    return st.current>0 ? ` · 🔥 ${st.current}` : '';
  })();
  return `
    <div class="rec-row">
      <div class="rec-top">
        <div>
          <div class="rec-title">${r.goalTitle}${streakTxt}</div>
          ${goal?.description ? `<div class="rec-desc">${goal.description}</div>` : ''}
        </div>
        <div class="rec-money">${moneyLine}</div>
      </div>
      <div class="rec-actions">${actions}</div>
    </div>`;
}

