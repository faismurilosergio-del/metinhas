    <div class="checkline"><input type="checkbox" id="g-sb-en" ${goal?.streakBonus?.enabled?'checked':''}><label for="g-sb-en">Bônus por sequência (streak)</label></div>
    <div class="field-row">
      <div class="field"><label>A cada quantos dias</label><input type="number" id="g-sb-every" value="${goal?.streakBonus?.everyN??7}"></div>
      <div class="field"><label>Valor do bônus</label><input type="number" step="0.01" id="g-sb-amt" value="${goal?.streakBonus?.amount??20}"></div>
