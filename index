  document.getElementById('mClose').onclick = closeModal;
  document.getElementById('buy-confirm').onclick = async ()=>{
    const personId = document.querySelector('input[name="buy-person"]:checked').value;
    await purchaseProduct(product, personId);
    closeModal();
  };
}

/* --- Desafio --- */
document.getElementById('newChallengeBtn').addEventListener('click', ()=>{
  const p1n = state.settings?.p1?.name||'Você', p2n = state.settings?.p2?.name||'Ela';
  const goalOptions = state.goals.map(g=>`<option value="${g.id}">${g.title}</option>`).join('');
  openModalHtml(`
    <button class="modal-close" id="mClose">×</button>
    <h3>Novo desafio</h3>
    <div class="field"><label>Título</label><input type="text" id="c-title" placeholder="Ex: 30 dias treinando"></div>
    <div class="field"><label>Descrição</label><textarea id="c-desc"></textarea></div>
    <div class="field">
      <label>Participantes</label>
      <div class="radio-cards">
        <label><input type="radio" name="c-part" value="p1" checked>${p1n}</label>
        <label><input type="radio" name="c-part" value="p2">${p2n}</label>
        <label><input type="radio" name="c-part" value="both">Casal</label>
      </div>
    </div>
    <div class="field-row">
      <div class="field"><label>Início</label><input type="date" id="c-start" value="${todayStr()}"></div>
      <div class="field"><label>Fim</label><input type="date" id="c-end" value="${addDays(todayStr(),30)}"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Meta de progresso (nº de vezes)</label><input type="number" id="c-target" value="30" min="1"></div>
      <div class="field"><label>Recompensa</label><input type="number" step="0.01" id="c-reward" value="50"></div>
    </div>
    <div class="field">
      <label>Vincular a uma meta existente (opcional — progresso automático)</label>
      <select id="c-linked"><option value="">Progresso manual (botão +1)</option>${goalOptions}</select>
    </div>
    <button class="btn btn-primary btn-block" id="c-save">Criar desafio</button>
  `);
  document.getElementById('mClose').onclick = closeModal;
  document.getElementById('c-save').onclick = async ()=>{
    const title = document.getElementById('c-title').value.trim();
    if(!title){ alert('Dê um título ao desafio.'); return; }
    await addDoc(col('challenges'), {
      title, description: document.getElementById('c-desc').value.trim(),
      participant: document.querySelector('input[name="c-part"]:checked').value,
      startDate: document.getElementById('c-start').value,
      endDate: document.getElementById('c-end').value,
      targetCount: Number(document.getElementById('c-target').value)||1,
      reward: Number(document.getElementById('c-reward').value)||0,
      linkedGoalId: document.getElementById('c-linked').value || null,
      currentCount: 0, status:'active', createdAt: serverTimestamp(),
    });
    closeModal();
  };
});

/* =========================================================
   NAVEGAÇÃO
   ========================================================= */
document.querySelectorAll('nav.tabbar button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('nav.tabbar button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    document.getElementById('view-'+btn.dataset.tab).classList.add('active');
    state.activeTab = btn.dataset.tab;
    render();
  });
});
document.getElementById('dateBack').addEventListener('click', ()=>{ state.currentDate = addDays(state.currentDate,-1); render(); });
document.getElementById('dateFwd').addEventListener('click', ()=>{
  if(state.currentDate < todayStr()){ state.currentDate = addDays(state.currentDate,1); render(); }
});
</script>
</body>
</html>
