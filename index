function periodicityLabel(p){
  if(!p) return '';
  if(p.type==='daily') return 'Todos os dias';
  if(p.type==='weekly_days') return (p.daysOfWeek||[]).map(d=>DOW_LABELS[d]).join(', ')||'—';
  if(p.type==='weekly_count') return `${p.timesPerWeek||1}x por semana`;
  if(p.type==='monthly_count') return `${p.timesPerMonth||1}x por mês`;
  if(p.type==='custom_interval') return `A cada ${p.intervalDays||1} dia(s)`;
  return '';
}
