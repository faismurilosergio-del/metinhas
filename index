<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Metinhas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F7F5FB;
    --surface:#FFFFFF;
    --ink:#231F2E;
    --ink-soft:#6B6480;
    --p1:#2F6B5E;
    --p1-soft:#E3F0EC;
    --p2:#C4547A;
    --p2-soft:#FBE7ED;
    --couple:#C98A1E;
    --couple-soft:#FBF0DC;
    --danger:#B5453D;
    --danger-soft:#F8E6E4;
    --border:#E7E3F1;
    --radius:16px;
    --radius-sm:10px;
    --shadow:0 2px 10px rgba(35,31,46,0.07);
    --font-display:'Fredoka', system-ui, sans-serif;
    --font-body:'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
    padding-bottom:84px;
  }
  h1,h2,h3,h4{font-family:var(--font-display);font-weight:600;margin:0;}
  p{margin:0;}
  button{font-family:var(--font-body);cursor:pointer;}
  input,select,textarea{font-family:var(--font-body);}
  ::selection{background:var(--couple-soft);}

  /* ---------- Loading ---------- */
  #loadingScreen{
    position:fixed;inset:0;background:var(--bg);z-index:999;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  }
  #loadingScreen .logo{font-family:var(--font-display);font-size:32px;color:var(--couple);}
  #loadingScreen .spinner{
    width:34px;height:34px;border-radius:50%;
    border:4px solid var(--border);border-top-color:var(--couple);
    animation:spin 0.8s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- Header ---------- */
  header.topbar{
    position:sticky;top:0;z-index:50;
    background:var(--surface);
    border-bottom:1px solid var(--border);
    padding:12px 16px;
    display:flex;align-items:center;justify-content:space-between;gap:10px;
  }
  header.topbar .brand{display:flex;align-items:center;gap:8px;}
  header.topbar .brand .logo-dot{
    width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--p1),var(--p2));
    display:flex;align-items:center;justify-content:center;font-size:15px;
  }
  header.topbar .brand h1{font-size:18px;color:var(--ink);}
  .wallet-strip{display:flex;gap:6px;overflow-x:auto;}
  .wallet-chip{
    display:flex;align-items:center;gap:5px;
    padding:6px 10px;border-radius:999px;white-space:nowrap;
    font-size:12.5px;font-weight:600;
  }
  .wallet-chip.p1{background:var(--p1-soft);color:var(--p1);}
  .wallet-chip.p2{background:var(--p2-soft);color:var(--p2);}
  .wallet-chip.couple{background:var(--couple-soft);color:var(--couple);}
  .icon-btn{
    width:36px;height:36px;border-radius:50%;border:1px solid var(--border);
    background:var(--surface);display:flex;align-items:center;justify-content:center;
    font-size:16px;flex-shrink:0;
  }
  .icon-btn:active{background:var(--bg);}

  /* ---------- Layout ---------- */
  main{max-width:760px;margin:0 auto;padding:16px 14px 24px;}
  .view{display:none;}
  .view.active{display:block;animation:fadein .18s ease;}
  @keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- Tab bar ---------- */
  nav.tabbar{
    position:fixed;bottom:0;left:0;right:0;z-index:50;
    background:var(--surface);border-top:1px solid var(--border);
    display:flex;justify-content:space-around;padding:6px 4px calc(6px + env(safe-area-inset-bottom));
  }
  nav.tabbar button{
    background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:2px;
    padding:6px 8px;border-radius:12px;color:var(--ink-soft);font-size:10.5px;font-weight:600;flex:1;
  }
  nav.tabbar button .tab-icon{font-size:19px;}
  nav.tabbar button.active{color:var(--couple);background:var(--couple-soft);}

  /* ---------- Cards / sections ---------- */
  .section-title{display:flex;align-items:center;justify-content:space-between;margin:22px 0 10px;}
  .section-title:first-child{margin-top:0;}
  .section-title h2{font-size:15.5px;color:var(--ink-soft);text-transform:none;}
  .card{
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:14px;box-shadow:var(--shadow);margin-bottom:10px;
  }
  .empty-state{
    text-align:center;padding:30px 16px;color:var(--ink-soft);
    background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);
  }
  .empty-state .em{font-size:26px;display:block;margin-bottom:6px;}

  /* ---------- Buttons ---------- */
  .btn{
    border-radius:999px;border:1px solid var(--border);background:var(--surface);
    padding:8px 14px;font-size:13.5px;font-weight:600;color:var(--ink);
  }
  .btn:active{transform:scale(0.97);}
  .btn-primary{background:var(--ink);color:#fff;border-color:var(--ink);}
  .btn-success{background:var(--p1);color:#fff;border-color:var(--p1);}
  .btn-danger{background:var(--danger);color:#fff;border-color:var(--danger);}
  .btn-ghost{background:transparent;border-color:transparent;color:var(--ink-soft);}
  .btn-sm{padding:5px 10px;font-size:12px;}
  .btn-block{width:100%;display:block;text-align:center;}
  .btn[disabled]{opacity:.45;pointer-events:none;}
  .btn-row{display:flex;gap:8px;flex-wrap:wrap;}

  /* ---------- Goal / record rows ---------- */
  .person-band{display:flex;align-items:center;gap:8px;margin:16px 0 8px;}
  .person-band .avatar{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;}
  .person-band.p1 .avatar{background:var(--p1-soft);}
  .person-band.p2 .avatar{background:var(--p2-soft);}
  .person-band.couple .avatar{background:var(--couple-soft);}
  .person-band strong{font-size:14px;}
  .person-band .stat{margin-left:auto;font-size:12px;color:var(--ink-soft);font-weight:600;}

  .rec-row{
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);
    padding:11px 12px;margin-bottom:8px;
  }
  .rec-row .rec-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}
  .rec-row .rec-title{font-size:14.5px;font-weight:600;}
  .rec-row .rec-desc{font-size:12.5px;color:var(--ink-soft);margin-top:2px;}
  .rec-row .rec-money{font-size:11.5px;font-weight:600;white-space:nowrap;}
  .rec-row .rec-money .rw{color:var(--p1);}
  .rec-row .rec-money .pn{color:var(--danger);margin-left:6px;}
  .rec-row .rec-actions{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;align-items:center;}
  .status-badge{
    display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;
  }
  .status-badge.completed{background:var(--p1-soft);color:var(--p1);}
  .status-badge.failed{background:var(--danger-soft);color:var(--danger);}
  .status-badge.skipped{background:var(--border);color:var(--ink-soft);}
  .status-badge.expired{background:var(--border);color:var(--ink-soft);}
  .value-entry{display:flex;gap:6px;align-items:center;}
  .value-entry input{width:90px;padding:6px 8px;border-radius:8px;border:1px solid var(--border);font-size:13px;}

  /* ---------- Date nav ---------- */
  .date-nav{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:14px;}
  .date-nav .date-label{font-family:var(--font-display);font-size:15px;min-width:150px;text-align:center;}
  .date-nav button{background:var(--surface);border:1px solid var(--border);border-radius:50%;width:34px;height:34px;}

  /* ---------- Progress ---------- */
  .progress-track{height:8px;border-radius:999px;background:var(--border);overflow:hidden;}
  .progress-fill{height:100%;border-radius:999px;}
  .progress-fill.p1{background:var(--p1);}
  .progress-fill.p2{background:var(--p2);}
  .progress-fill.couple{background:var(--couple);}

  /* ---------- Metas list ---------- */
  .goal-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:8px;}
  .goal-card.inactive{opacity:.5;}
  .goal-card .g-top{display:flex;justify-content:space-between;gap:8px;}
  .goal-card .g-title{font-weight:600;font-size:14.5px;}
  .goal-card .g-meta{font-size:12px;color:var(--ink-soft);margin-top:4px;}
  .chip{display:inline-block;background:var(--bg);border:1px solid var(--border);border-radius:999px;padding:2px 8px;font-size:11px;color:var(--ink-soft);margin-right:5px;margin-top:5px;}

  /* ---------- Store ---------- */
  .product-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:8px;display:flex;gap:12px;align-items:center;}
  .product-card .p-emoji{font-size:30px;width:46px;text-align:center;flex-shrink:0;}
  .product-card .p-body{flex:1;min-width:0;}
  .product-card .p-title{font-weight:600;font-size:14.5px;}
  .product-card .p-desc{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .product-card .p-meta{font-size:11.5px;color:var(--ink-soft);margin-top:4px;}
  .product-card .p-actions{display:flex;flex-direction:column;gap:6px;align-items:flex-end;}

  /* ---------- Challenges ---------- */
  .challenge-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:13px;margin-bottom:8px;}
  .challenge-card .c-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;}
  .challenge-card .c-title{font-weight:600;font-size:14.5px;}
  .challenge-card .c-desc{font-size:12.5px;color:var(--ink-soft);margin:3px 0 8px;}
  .challenge-card .c-progress-label{display:flex;justify-content:space-between;font-size:11.5px;color:var(--ink-soft);margin-top:5px;}

  /* ---------- Dashboard ---------- */
  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
  .stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;}
  .stat-card .val{font-family:var(--font-display);font-size:21px;}
  .stat-card .lbl{font-size:11.5px;color:var(--ink-soft);margin-top:2px;}
  table.compare{width:100%;border-collapse:collapse;font-size:12.5px;}
  table.compare th, table.compare td{padding:7px 6px;text-align:center;border-bottom:1px solid var(--border);}
  table.compare th:first-child, table.compare td:first-child{text-align:left;color:var(--ink-soft);}
  table.compare th{font-size:11px;color:var(--ink-soft);font-weight:600;}
  .badge-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:8px;}
  .badge-tile{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 6px;text-align:center;}
  .badge-tile.locked{opacity:.35;}
  .badge-tile .b-emoji{font-size:22px;}
  .badge-tile .b-title{font-size:10px;font-weight:600;margin-top:4px;line-height:1.25;}
  svg.chart text{font-family:var(--font-body);fill:var(--ink-soft);font-size:9px;}

  /* ---------- Modal ---------- */
  #modalRoot{position:fixed;inset:0;z-index:200;}
  .modal-overlay{position:fixed;inset:0;background:rgba(35,31,46,0.45);display:flex;align-items:flex-end;justify-content:center;}
  @media (min-width:640px){.modal-overlay{align-items:center;}}
  .modal-box{
    background:var(--surface);width:100%;max-width:520px;max-height:88vh;overflow-y:auto;
    border-radius:20px 20px 0 0;padding:18px 18px 24px;
  }
  @media (min-width:640px){.modal-box{border-radius:20px;}}
  .modal-box h3{font-size:17px;margin-bottom:12px;}
  .modal-close{float:right;background:none;border:none;font-size:20px;color:var(--ink-soft);line-height:1;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:5px;}
  .field input[type=text],.field input[type=number],.field input[type=date],.field select,.field textarea{
    width:100%;padding:10px 11px;border-radius:10px;border:1px solid var(--border);font-size:14px;background:var(--bg);color:var(--ink);
  }
  .field textarea{min-height:56px;resize:vertical;}
  .field-row{display:flex;gap:10px;}
  .field-row .field{flex:1;}
  .checkline{display:flex;align-items:center;gap:8px;font-size:13.5px;margin-bottom:10px;}
  .checkline input{width:16px;height:16px;}
  .daychecks{display:flex;gap:5px;flex-wrap:wrap;}
  .daychecks label{
    border:1px solid var(--border);border-radius:8px;padding:6px 0;width:36px;text-align:center;font-size:11.5px;color:var(--ink-soft);
    display:flex;flex-direction:column;align-items:center;gap:2px;background:var(--bg);
  }
  .daychecks input{width:14px;height:14px;}
  .fieldset-label{font-size:11.5px;font-weight:700;color:var(--couple);text-transform:uppercase;letter-spacing:.03em;margin:16px 0 8px;}
  .fieldset-label:first-child{margin-top:0;}
  .radio-cards{display:flex;gap:8px;flex-wrap:wrap;}
  .radio-cards label{
    border:1px solid var(--border);border-radius:10px;padding:8px 12px;font-size:13px;cursor:pointer;background:var(--bg);
  }
  .radio-cards input{margin-right:5px;}

  /* misc */
  .muted{color:var(--ink-soft);font-size:12.5px;}
  .hidden{display:none !important;}
  .flex-between{display:flex;justify-content:space-between;align-items:center;}
</style>
</head>
<body>

<div id="loadingScreen">
  <div class="logo">💞 Metinhas</div>
  <div class="spinner"></div>
  <p class="muted">Carregando dados do casal…</p>
</div>

<header class="topbar">
  <div class="brand">
    <div class="logo-dot">💞</div>
    <h1 id="appTitle">Metinhas</h1>
  </div>
  <div class="wallet-strip" id="walletStrip"></div>
  <button class="icon-btn" id="settingsBtn" title="Configurações">⚙️</button>
</header>

<main>
  <!-- AGENDA -->
  <section class="view active" id="view-agenda">
    <div class="date-nav">
      <button id="dateBack">◀</button>
      <div class="date-label" id="dateLabel">Hoje</div>
      <button id="dateFwd">▶</button>
    </div>
    <div id="agendaSummary"></div>
    <div id="agendaLists"></div>
  </section>

  <!-- METAS -->
  <section class="view" id="view-metas">
    <div class="section-title">
      <h2>Metas ativas</h2>
      <button class="btn btn-primary btn-sm" id="newGoalBtn">+ Nova meta</button>
    </div>
    <div id="goalsList"></div>
  </section>

  <!-- LOJA -->
  <section class="view" id="view-loja">
    <div class="section-title">
      <h2>Recompensas do casal</h2>
      <button class="btn btn-primary btn-sm" id="newProductBtn">+ Novo produto</button>
    </div>
    <div id="productsList"></div>
    <div class="section-title"><h2>Extrato da carteira</h2></div>
    <div id="ledgerList"></div>
  </section>

  <!-- DESAFIOS -->
  <section class="view" id="view-desafios">
    <div class="section-title">
      <h2>Desafios</h2>
      <button class="btn btn-primary btn-sm" id="newChallengeBtn">+ Novo desafio</button>
    </div>
    <div id="challengesList"></div>
  </section>

  <!-- DASHBOARD -->
  <section class="view" id="view-dashboard">
    <div class="section-title"><h2>Hoje</h2></div>
    <div class="stat-grid" id="dashToday"></div>

    <div class="section-title"><h2>Últimos 7 dias</h2></div>
    <div class="card"><div id="dashWeekChart"></div></div>

    <div class="section-title"><h2 id="dashMonthLabel">Este mês</h2></div>
    <div class="stat-grid" id="dashMonth"></div>

    <div class="section-title"><h2>Comparação do casal</h2></div>
    <div class="card"><div id="dashCompare"></div></div>

    <div class="section-title"><h2>Conquistas</h2></div>
    <div class="badge-grid" id="dashBadges"></div>
  </section>
</main>

<nav class="tabbar">
  <button data-tab="agenda" class="active"><span class="tab-icon">📅</span>Agenda</button>
  <button data-tab="metas"><span class="tab-icon">🎯</span>Metas</button>
  <button data-tab="loja"><span class="tab-icon">🛍️</span>Loja</button>
  <button data-tab="desafios"><span class="tab-icon">🔥</span>Desafios</button>
  <button data-tab="dashboard"><span class="tab-icon">📊</span>Painel</button>
</nav>

<div id="modalRoot"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
import {
  getFirestore, collection, doc, addDoc, setDoc, updateDoc, deleteDoc,
  onSnapshot, getDoc, serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";

/* =========================================================
   FIREBASE INIT
   ========================================================= */
const firebaseConfig = {
  apiKey: "AIzaSyDY2n_zjBcCfUMP_tKucfDodTRoVM4-Hvs",
  authDomain: "metinhas-b0ead.firebaseapp.com",
  projectId: "metinhas-b0ead",
  storageBucket: "metinhas-b0ead.firebasestorage.app",
  messagingSenderId: "482708770706",
  appId: "1:482708770706:web:2e5c8a78d830e48c00fb4b"
};
const fbApp = initializeApp(firebaseConfig);
const db = getFirestore(fbApp);
const col = (name) => collection(db, name);

/* =========================================================
   STATE
   ========================================================= */
const state = {
  settings: null,
  goals: [], records: [], transactions: [], products: [], purchases: [], challenges: [],
  currentDate: todayStr(),
  activeTab: 'agenda',
};
const ready = { settings:false, goals:false, records:false, transactions:false, products:false, purchases:false, challenges:false };
function allReady(){ return Object.values(ready).every(Boolean); }
function markReady(k){ ready[k]=true; if(allReady()){ document.getElementById('loadingScreen').style.display='none'; } }

let renderScheduled = false;
function scheduleRender(){
  if(renderScheduled) return;
  renderScheduled = true;
  setTimeout(()=>{ renderScheduled=false; runSyncThenRender(); }, 120);
}

/* =========================================================
   DATE HELPERS
   ========================================================= */
function todayStr(d=new Date()){
  const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), day=String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${day}`;
}
function addDays(dateStr, n){
  const [y,m,d]=dateStr.split('-').map(Number);
  const dt=new Date(y,m-1,d); dt.setDate(dt.getDate()+n);
  return todayStr(dt);
}
function dayOfWeek(dateStr){
  const [y,m,d]=dateStr.split('-').map(Number);
  return new Date(y,m-1,d).getDay();
}
function isoWeekKey(dateStr){
  const [y,m,d]=dateStr.split('-').map(Number);
  const dt=new Date(Date.UTC(y,m-1,d));
  const dayNum=(dt.getUTCDay()+6)%7;
  dt.setUTCDate(dt.getUTCDate()-dayNum+3);
  const firstThursday=new Date(Date.UTC(dt.getUTCFullYear(),0,4));
  const week=1+Math.round(((dt-firstThursday)/86400000-3+((firstThursday.getUTCDay()+6)%7))/7);
  return `${dt.getUTCFullYear()}-W${String(week).padStart(2,'0')}`;
}
const DOW_LABELS=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
const MONTH_LABELS=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
function fmtDatePt(dateStr){
  const [y,m,d]=dateStr.split('-').map(Number);
  const dt=new Date(y,m-1,d);
  return `${DOW_LABELS[dt.getDay()]}, ${d} ${MONTH_LABELS[m-1].slice(0,3)}`;
}
function fmtMoney(v){
  const cur = state.settings?.currency || 'R$';
  const sign = v<0?'-':'';
  return `${sign}${cur} ${Math.abs(v).toFixed(2).replace('.',',')}`;
}

/* =========================================================
   FIRESTORE LISTENERS
   ========================================================= */
onSnapshot(doc(db,'settings','config'), async (snap)=>{
  if(snap.exists()){ state.settings = snap.data(); }
  else {
    const def = { p1:{name:'Você', emoji:'🧑'}, p2:{name:'Ela', emoji:'👩'}, coupleName:'Metinhas', currency:'R$' };
    await setDoc(doc(db,'settings','config'), def);
    state.settings = def;
  }
  document.getElementById('appTitle').textContent = state.settings.coupleName || 'Metinhas';
  markReady('settings'); scheduleRender();
});
onSnapshot(col('goals'), (snap)=>{
  state.goals = snap.docs.map(d=>({id:d.id, ...d.data()}));
  markReady('goals'); scheduleRender();
});
onSnapshot(col('goalRecords'), (snap)=>{
  state.records = snap.docs.map(d=>({id:d.id, ...d.data()}));
  markReady('records'); scheduleRender();
});
onSnapshot(col('transactions'), (snap)=>{
  state.transactions = snap.docs.map(d=>({id:d.id, ...d.data()}));
  markReady('transactions'); scheduleRender();
});
onSnapshot(col('products'), (snap)=>{
  state.products = snap.docs.map(d=>({id:d.id, ...d.data()}));
  markReady('products'); scheduleRender();
});
onSnapshot(col('purchases'), (snap)=>{
  state.purchases = snap.docs.map(d=>({id:d.id, ...d.data()}));
  markReady('purchases'); scheduleRender();
});
onSnapshot(col('challenges'), (snap)=>{
  state.challenges = snap.docs.map(d=>({id:d.id, ...d.data()}));
