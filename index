/* =========================================================
   CORE ENGINE: periodicidade, geração e resolução de execuções
   ========================================================= */
function instancesFor(goal){
  if(goal.participant==='p1') return ['p1'];
  if(goal.participant==='p2') return ['p2'];
  return goal.responsibilityType==='either' ? ['both'] : ['p1','p2'];
}
function countCompletedInPeriod(goalId, personId, periodKey, periodFn){
  return state.records.filter(r=>r.goalId===goalId && r.personId===personId && r.status==='completed' && periodFn(r.date)===periodKey).length;
}
function goalDue(goal, personId, dateStr){
  const p = goal.periodicity || {type:'daily'};
  if(p.type==='daily') return true;
  if(p.type==='weekly_days') return (p.daysOfWeek||[]).includes(dayOfWeek(dateStr));
  if(p.type==='weekly_count'){
    const wk=isoWeekKey(dateStr);
    return countCompletedInPeriod(goal.id,personId,wk,isoWeekKey) < (p.timesPerWeek||1);
  }
  if(p.type==='monthly_count'){
    const mk=dateStr.slice(0,7);
    return countCompletedInPeriod(goal.id,personId,mk,d=>d.slice(0,7)) < (p.timesPerMonth||1);
  }
  if(p.type==='custom_interval'){
    const anchor = goal.createdAtDate || dateStr;
    const diff = Math.round((new Date(dateStr) - new Date(anchor))/86400000);
    return diff>=0 && diff % (p.intervalDays||1) === 0;
  }
  return false;
}
let syncing=false;
async function runSyncThenRender(){
  if(!allReady()){ render(); return; }
  if(syncing){ render(); return; }
  syncing=true;
  try{
    await generateRecordsForToday();
    await resolveStalePending();
    await evaluateChallenges();
  } catch(e){ console.error('Erro no sync', e); }
  syncing=false;
  render();
}
async function generateRecordsForToday(){
  const dateStr = todayStr();
  for(const goal of state.goals){
    if(goal.active===false) continue;
    for(const personId of instancesFor(goal)){
      if(!goalDue(goal, personId, dateStr)) continue;
      const exists = state.records.some(r=>r.goalId===goal.id && r.personId===personId && r.date===dateStr);
      if(exists) continue;
      await addDoc(col('goalRecords'), {
        goalId: goal.id, goalTitle: goal.title, personId, date: dateStr,
        status:'pending', measuredValue:null,
        measurementType: goal.measurementType, targetValue: goal.targetValue||null, unit: goal.unit||'',
        rewardSnapshot: (goal.reward?.enabled ? Number(goal.reward.amount)||0 : 0),
        penaltySnapshot: (goal.penalty?.enabled ? Number(goal.penalty.amount)||0 : 0),
        amountApplied:null, createdAt: serverTimestamp(), resolvedAt:null,
      });
      // evita criar múltiplos no mesmo ciclo de sync
      state.records.push({id:'temp-'+Math.random(), goalId:goal.id, personId, date:dateStr, status:'pending'});
    }
  }
}
async function resolveStalePending(){
  const today = todayStr();
  const stale = state.records.filter(r=>r.status==='pending' && r.date<today && !String(r.id).startsWith('temp-'));
  for(const r of stale){
    const penalty = r.penaltySnapshot||0;
    if(penalty>0){
      await updateDoc(doc(db,'goalRecords',r.id), {status:'failed', amountApplied:-penalty, resolvedAt:serverTimestamp()});
      await addDoc(col('transactions'), {
        personId: r.personId==='both'?'couple':r.personId, type:'goal_penalty', amount:-penalty,
        description:`Meta não cumprida: ${r.goalTitle}`, relatedId:r.id, date:r.date, createdAt:serverTimestamp()
      });
    } else {
      await updateDoc(doc(db,'goalRecords',r.id), {status:'expired', amountApplied:0, resolvedAt:serverTimestamp()});
    }
    r.status = penalty>0 ? 'failed' : 'expired';
  }
}
async function evaluateChallenges(){
  const today = todayStr();
  for(const c of state.challenges){
    if(c.status!=='active') continue;
    let count = c.currentCount||0;
    if(c.linkedGoalId){
      count = state.records.filter(r=>r.goalId===c.linkedGoalId && r.status==='completed' && r.date>=c.startDate && r.date<=c.endDate).length;
    }
    if(count >= c.targetCount){
      await updateDoc(doc(db,'challenges',c.id), {status:'completed', currentCount:count});
      c.status='completed';
      await addDoc(col('transactions'), {
        personId: c.participant==='both'?'couple':c.participant, type:'challenge_reward', amount:Number(c.reward)||0,
        description:`Desafio concluído: ${c.title}`, relatedId:c.id, date:today, createdAt:serverTimestamp()
      });
    } else if(today > c.endDate){
      await updateDoc(doc(db,'challenges',c.id), {status:'failed', currentCount:count});
      c.status='failed';
    }
  }
}

/* =========================================================
   AÇÕES DE EXECUÇÃO (concluir / não cumprir / pular)
   ========================================================= */
async function completeRecord(record, measuredValue){
  let ratio = 1;
  if(record.measurementType!=='boolean' && record.targetValue){
    ratio = Math.max(0, Math.min(1, (Number(measuredValue)||0)/record.targetValue));
  }
  const reward = record.measurementType==='boolean' ? (record.rewardSnapshot||0) : (record.rewardSnapshot||0)*ratio;
  const status = (record.measurementType==='boolean' || ratio>0) ? 'completed' : 'failed';
  const amountApplied = status==='completed' ? reward : -(record.penaltySnapshot||0);
  await updateDoc(doc(db,'goalRecords',record.id), {
    status, measuredValue: measuredValue==null?null:Number(measuredValue), amountApplied, resolvedAt:serverTimestamp()
  });
  const payPerson = record.personId==='both'?'couple':record.personId;
  if(status==='completed' && reward>0){
    await addDoc(col('transactions'), {
      personId:payPerson, type:'goal_reward', amount:reward,
      description:`Meta cumprida: ${record.goalTitle}${ratio<1?` (${Math.round(ratio*100)}%)`:''}`,
      relatedId:record.id, date:record.date, createdAt:serverTimestamp()
    });
  } else if(status==='failed' && record.penaltySnapshot>0){
    await addDoc(col('transactions'), {
      personId:payPerson, type:'goal_penalty', amount:-record.penaltySnapshot,
      description:`Meta não cumprida: ${record.goalTitle}`, relatedId:record.id, date:record.date, createdAt:serverTimestamp()
    });
  }
  const goal = state.goals.find(g=>g.id===record.goalId);
  if(status==='completed') await maybeApplyStreakBonus(goal, record.personId);
}
async function failRecord(record){
  const penalty = record.penaltySnapshot||0;
  await updateDoc(doc(db,'goalRecords',record.id), {status:'failed', amountApplied: penalty?-penalty:0, resolvedAt:serverTimestamp()});
  if(penalty>0){
    await addDoc(col('transactions'), {
      personId: record.personId==='both'?'couple':record.personId, type:'goal_penalty', amount:-penalty,
      description:`Meta não cumprida: ${record.goalTitle}`, relatedId:record.id, date:record.date, createdAt:serverTimestamp()
    });
  }
}
async function skipRecord(record){
  await updateDoc(doc(db,'goalRecords',record.id), {status:'skipped', amountApplied:0, resolvedAt:serverTimestamp()});
}
async function maybeApplyStreakBonus(goal, personId){
  if(!goal?.streakBonus?.enabled) return;
  const streak = computeStreak(goal.id, personId).current;
  const everyN = Number(goal.streakBonus.everyN)||7;
  if(streak>0 && streak % everyN === 0){
    await addDoc(col('transactions'), {
      personId: personId==='both'?'couple':personId, type:'streak_bonus', amount:Number(goal.streakBonus.amount)||0,
      description:`Bônus de sequência (${streak} dias): ${goal.title}`, relatedId:goal.id, date:todayStr(), createdAt:serverTimestamp()
    });
  }
}
function computeStreak(goalId, personId){
  const completedDates = new Set(state.records.filter(r=>r.goalId===goalId && r.personId===personId && r.status==='completed').map(r=>r.date));
  let d = todayStr();
  const todayRec = state.records.find(r=>r.goalId===goalId && r.personId===personId && r.date===d);
  if(!todayRec || todayRec.status==='pending') d = addDays(d,-1);
  let current=0;
  while(true){
    if(completedDates.has(d)){ current++; d=addDays(d,-1); continue; }
    const rec = state.records.find(r=>r.goalId===goalId && r.personId===personId && r.date===d);
    if(rec && rec.status==='skipped'){ d=addDays(d,-1); continue; }
    break;
  }
  const sorted=[...completedDates].sort();
  let bestRun=0, curRun=0, prev=null;
  for(const dt of sorted){
    curRun = (prev && addDays(prev,1)===dt) ? curRun+1 : 1;
    bestRun = Math.max(bestRun, curRun);
    prev = dt;
  }
  return { current, best: Math.max(bestRun, current) };
}
function bestOverallStreak(){
  let best=0;
  const combos = new Set(state.records.map(r=>r.goalId+'|'+r.personId));
  combos.forEach(c=>{ const [gid,pid]=c.split('|'); best=Math.max(best, computeStreak(gid,pid).best); });
  return best;
}
function balance(personId){
  return state.transactions.filter(t=>t.personId===personId).reduce((s,t)=>s+t.amount,0);
}

/* =========================================================
   LOJA: compra e disponibilidade
   ========================================================= */
function productAvailability(product){
  if((product.stockQuantity||0)<=0) return {available:false, reason:'Sem estoque'};
  const rel = state.purchases.filter(p=>p.productId===product.id).sort((a,b)=>b.purchasedAt.localeCompare(a.purchasedAt));
  const last = rel[0];
  if(last && last.availableAgainAt > todayStr()) return {available:false, reason:`Volta em ${fmtDatePt(last.availableAgainAt)}`};
  return {available:true};
}
async function purchaseProduct(product, personId){
  await updateDoc(doc(db,'products',product.id), {stockQuantity:(product.stockQuantity||0)-1});
  const availableAgain = addDays(todayStr(), product.cooldownDays||0);
  await addDoc(col('purchases'), {
    productId:product.id, productName:product.name, personId, price:Number(product.price)||0,
    purchasedAt: todayStr(), availableAgainAt: availableAgain, createdAt: serverTimestamp()
  });
  await addDoc(col('transactions'), {
    personId, type:'purchase', amount:-(Number(product.price)||0),
    description:`Compra: ${product.name}`, relatedId:product.id, date:todayStr(), createdAt:serverTimestamp()
  });
}

