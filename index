document.getElementById('newGoalBtn').addEventListener('click', ()=>openGoalModal(null));
function openGoalModal(goal){
  const isEdit = !!goal;
  const p1n = state.settings?.p1?.name||'Você', p2n = state.settings?.p2?.name||'Ela';
  const per = goal?.periodicity || {type:'daily'};
  const dayChecks = DOW_LABELS.map((lbl,i)=>`
    <label><input type="checkbox" name="dow" value="${i}" ${(per.daysOfWeek||[]).includes(i)?'checked':''}>${lbl}</label>`).join('');
  openModalHtml(`
    <button class="modal-close" id="mClose">×</button>
    <h3>${isEdit?'Editar meta':'Nova meta'}</h3>

    <div class="fieldset-label">Identidade</div>
    <div class="field"><label>Nome da meta</label><input type="text" id="g-title" value="${goal?.title||''}" placeholder="Ex: Treinar"></div>
    <div class="field"><label>Descrição</label><textarea id="g-desc">${goal?.description||''}</textarea></div>

    <div class="fieldset-label">Participantes</div>
    <div class="field">
      <div class="radio-cards">
        <label><input type="radio" name="g-part" value="p1" ${(!goal||goal.participant==='p1')?'checked':''}>${p1n}</label>
        <label><input type="radio" name="g-part" value="p2" ${goal?.participant==='p2'?'checked':''}>${p2n}</label>
        <label><input type="radio" name="g-part" value="both" ${goal?.participant==='both'?'checked':''}>Nós dois</label>
      </div>
    </div>
    <div class="field" id="g-resp-wrap" style="${goal?.participant==='both'?'':'display:none'}">
      <label>Tipo de responsabilidade</label>
      <div class="radio-cards">
        <label><input type="radio" name="g-resp" value="each" ${(!goal||goal.responsibilityType!=='either')?'checked':''}>Cada um cumpre a sua</label>
        <label><input type="radio" name="g-resp" value="either" ${goal?.responsibilityType==='either'?'checked':''}>Basta um cumprir</label>
      </div>
    </div>

    <div class="fieldset-label">Tipo de medição</div>
    <div class="field">
      <select id="g-mtype">
        <option value="boolean" ${(!goal||goal.measurementType==='boolean')?'selected':''}>Sim / Não</option>
        <option value="numeric" ${goal?.measurementType==='numeric'?'selected':''}>Numérico</option>
        <option value="financial" ${goal?.measurementType==='financial'?'selected':''}>Financeiro</option>
        <option value="percentage" ${goal?.measurementType==='percentage'?'selected':''}>Percentual</option>
        <option value="quantity" ${goal?.measurementType==='quantity'?'selected':''}>Quantidade</option>
        <option value="time" ${goal?.measurementType==='time'?'selected':''}>Tempo</option>
      </select>
    </div>
    <div class="field-row" id="g-target-wrap" style="${(!goal||goal.measurementType==='boolean')?'display:none':''}">
      <div class="field"><label>Meta (valor alvo)</label><input type="number" step="any" id="g-target" value="${goal?.targetValue??''}"></div>
      <div class="field"><label>Unidade</label><input type="text" id="g-unit" value="${goal?.unit||''}" placeholder="ml, min, páginas..."></div>
    </div>

    <div class="fieldset-label">Periodicidade</div>
    <div class="field">
      <select id="g-ptype">
        <option value="daily" ${per.type==='daily'?'selected':''}>Todos os dias</option>
        <option value="weekly_days" ${per.type==='weekly_days'?'selected':''}>Dias específicos da semana</option>
        <option value="weekly_count" ${per.type==='weekly_count'?'selected':''}>X vezes por semana</option>
        <option value="monthly_count" ${per.type==='monthly_count'?'selected':''}>X vezes por mês</option>
        <option value="custom_interval" ${per.type==='custom_interval'?'selected':''}>Intervalo personalizado</option>
      </select>
    </div>
    <div class="field" id="g-p-days" style="${per.type==='weekly_days'?'':'display:none'}"><div class="daychecks">${dayChecks}</div></div>
    <div class="field" id="g-p-weekcount" style="${per.type==='weekly_count'?'':'display:none'}"><label>Vezes por semana</label><input type="number" id="g-timesweek" value="${per.timesPerWeek||3}" min="1" max="7"></div>
    <div class="field" id="g-p-monthcount" style="${per.type==='monthly_count'?'':'display:none'}"><label>Vezes por mês</label><input type="number" id="g-timesmonth" value="${per.timesPerMonth||4}" min="1"></div>
    <div class="field" id="g-p-interval" style="${per.type==='custom_interval'?'':'display:none'}"><label>Intervalo (dias)</label><input type="number" id="g-interval" value="${per.intervalDays||2}" min="1"></div>

    <div class="fieldset-label">Economia da meta</div>
    <div class="checkline"><input type="checkbox" id="g-rw-en" ${(!goal||goal.reward?.enabled!==false)?'checked':''}><label for="g-rw-en">Dar recompensa ao cumprir</label></div>
