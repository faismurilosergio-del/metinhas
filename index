    if(ptype==='weekly_count') periodicity.timesPerWeek = Number(document.getElementById('g-timesweek').value)||1;
    if(ptype==='monthly_count') periodicity.timesPerMonth = Number(document.getElementById('g-timesmonth').value)||1;
    if(ptype==='custom_interval') periodicity.intervalDays = Number(document.getElementById('g-interval').value)||1;

    const payload = {
      title, description: document.getElementById('g-desc').value.trim(),
      participant, responsibilityType: participant==='both'?responsibilityType:null,
      measurementType: mtype,
      targetValue: mtype==='boolean'? null : Number(document.getElementById('g-target').value)||0,
      unit: mtype==='boolean'? '' : document.getElementById('g-unit').value.trim(),
      periodicity,
      reward: { enabled: document.getElementById('g-rw-en').checked, amount: Number(document.getElementById('g-rw-amt').value)||0 },
      penalty: { enabled: document.getElementById('g-pn-en').checked, amount: Number(document.getElementById('g-pn-amt').value)||0 },
      streakBonus: { enabled: document.getElementById('g-sb-en').checked, everyN: Number(document.getElementById('g-sb-every').value)||7, amount: Number(document.getElementById('g-sb-amt').value)||0 },
      active: goal?.active ?? true,
      updatedAt: serverTimestamp(),
    };
    if(isEdit){
      await updateDoc(doc(db,'goals',goal.id), payload);
    } else {
      payload.createdAt = serverTimestamp();
      payload.createdAtDate = todayStr();
      await addDoc(col('goals'), payload);
    }
    closeModal();
  };
}

