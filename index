/* ---- DESAFIOS ---- */
function renderDesafios(){
  const el = document.getElementById('challengesList');
  if(state.challenges.length===0){
    el.innerHTML = `<div class="empty-state"><span class="em">🔥</span>Nenhum desafio criado ainda.</div>`;
    return;
  }
  const order = {active:0, completed:1, failed:2};
  const sorted = [...state.challenges].sort((a,b)=>order[a.status]-order[b.status]);
  el.innerHTML = sorted.map(c=>{
    let count = c.currentCount||0;
    if(c.linkedGoalId){
      count = state.records.filter(r=>r.goalId===c.linkedGoalId && r.status==='completed' && r.date>=c.startDate && r.date<=c.endDate).length;
    }
    const pct = Math.min(100, Math.round((count/(c.targetCount||1))*100));
    const statusLabel = {active:'Em andamento', completed:'Concluído 🎉', failed:'Não concluído'}[c.status];
    return `
    <div class="challenge-card">
      <div class="c-top">
        <div>
          <div class="c-title">${c.title}</div>
          <div class="muted">${c.participant==='both'?'Casal':personLabel(c.participant)} · até ${fmtDatePt(c.endDate)}</div>
        </div>
        <span class="status-badge ${c.status==='completed'?'completed':c.status==='failed'?'failed':'skipped'}">${statusLabel}</span>
      </div>
      ${c.description?`<div class="c-desc">${c.description}</div>`:''}
      <div class="progress-track"><div class="progress-fill couple" style="width:${pct}%"></div></div>
      <div class="c-progress-label">
        <span>${count}/${c.targetCount} ${c.linkedGoalId?'(automático)':''}</span>
        <span>Recompensa: ${fmtMoney(c.reward||0)}</span>
      </div>
      <div class="btn-row" style="margin-top:8px;">
        ${(!c.linkedGoalId && c.status==='active') ? `<button class="btn btn-success btn-sm" data-inc="${c.id}">+1 progresso</button>` : ''}
        <button class="btn btn-ghost btn-sm" data-del-chal="${c.id}">🗑️</button>
      </div>
    </div>`;
  }).join('');
  el.querySelectorAll('[data-inc]').forEach(b=>b.addEventListener('click', async ()=>{
    const c = state.challenges.find(x=>x.id===b.dataset.inc);
    await updateDoc(doc(db,'challenges',c.id), {currentCount:(c.currentCount||0)+1});
  }));
  el.querySelectorAll('[data-del-chal]').forEach(b=>b.addEventListener('click', async ()=>{
    if(confirm('Excluir este desafio?')) await deleteDoc(doc(db,'challenges',b.dataset.delChal));
  }));
}

/* ---- DASHBOARD ---- */
function renderDashboard(){
  const today = todayStr();
  // Hoje
  const todayRecs = state.records.filter(r=>r.date===today);
  const pctFor = (pid)=>{
    const rs = todayRecs.filter(r=>r.personId===pid);
    return rs.length ? Math.round(rs.filter(r=>r.status==='completed').length/rs.length*100) : 0;
  };
  document.getElementById('dashToday').innerHTML = `
    <div class="stat-card"><div class="val" style="color:var(--p1)">${pctFor('p1')}%</div><div class="lbl">${personLabel('p1')} concluído hoje</div></div>
    <div class="stat-card"><div class="val" style="color:var(--p2)">${pctFor('p2')}%</div><div class="lbl">${personLabel('p2')} concluído hoje</div></div>
  `;

  // Semana (últimos 7 dias)
  const days = Array.from({length:7}, (_,i)=>addDays(today, i-6));
  const dayCounts = days.map(d=>{
    const rs = state.records.filter(r=>r.date===d);
    const done = rs.filter(r=>r.status==='completed').length;
    return {d, total:rs.length, done};
  });
  const maxVal = Math.max(1, ...dayCounts.map(x=>x.total));
  const barW=36, gap=10, chartH=90, chartW=days.length*(barW+gap);
  let bars='';
  dayCounts.forEach((x,i)=>{
    const h = Math.round((x.total? x.done/maxVal : 0)*chartH);
    const totalH = Math.round((x.total/maxVal)*chartH);
    const xPos = i*(barW+gap);
    bars += `<rect x="${xPos}" y="${chartH-totalH}" width="${barW}" height="${totalH}" rx="6" fill="var(--border)"></rect>`;
    bars += `<rect x="${xPos}" y="${chartH-h}" width="${barW}" height="${h}" rx="6" fill="var(--couple)"></rect>`;
    bars += `<text x="${xPos+barW/2}" y="${chartH+14}" text-anchor="middle">${DOW_LABELS[dayOfWeek(x.d)]}</text>`;
    bars += `<text x="${xPos+barW/2}" y="${chartH-h-4}" text-anchor="middle" style="font-weight:700;fill:var(--ink)">${x.done}</text>`;
  });
  document.getElementById('dashWeekChart').innerHTML = `<svg class="chart" viewBox="0 0 ${chartW} ${chartH+22}" width="100%" height="120">${bars}</svg>`;

  // Mês
  const monthKey = today.slice(0,7);
  document.getElementById('dashMonthLabel').textContent = `${MONTH_LABELS[Number(monthKey.slice(5,7))-1]} de ${monthKey.slice(0,4)}`;
  const monthRecs = state.records.filter(r=>r.date.slice(0,7)===monthKey && r.status!=='pending');
  const monthTx = state.transactions.filter(t=>t.date.slice(0,7)===monthKey);
  const completedCount = monthRecs.filter(r=>r.status==='completed').length;
  const taxaSucesso = monthRecs.length ? Math.round(completedCount/monthRecs.length*100) : 0;
  const ganho = monthTx.filter(t=>t.amount>0 && t.type!=='purchase').reduce((s,t)=>s+t.amount,0);
  const penal = monthTx.filter(t=>t.type==='goal_penalty').reduce((s,t)=>s+t.amount,0);
  const compras = monthTx.filter(t=>t.type==='purchase').reduce((s,t)=>s+t.amount,0);
  document.getElementById('dashMonth').innerHTML = `
    <div class="stat-card"><div class="val">${completedCount}</div><div class="lbl">Metas concluídas</div></div>
    <div class="stat-card"><div class="val">${taxaSucesso}%</div><div class="lbl">Taxa de sucesso</div></div>
    <div class="stat-card"><div class="val" style="color:var(--p1)">${fmtMoney(ganho)}</div><div class="lbl">Ganho no mês</div></div>
    <div class="stat-card"><div class="val" style="color:var(--danger)">${fmtMoney(penal)}</div><div class="lbl">Penalidades</div></div>
    <div class="stat-card"><div class="val">${fmtMoney(Math.abs(compras))}</div><div class="lbl">Gasto na loja</div></div>
    <div class="stat-card"><div class="val">🔥 ${bestOverallStreak()}</div><div class="lbl">Melhor sequência geral</div></div>
  `;

  // Comparação
  const cmp = (pid)=>{
    const recs = monthRecs.filter(r=>r.personId===pid);
    const done = recs.filter(r=>r.status==='completed').length;
    const g = monthTx.filter(t=>t.personId===pid && t.amount>0 && t.type!=='purchase').reduce((s,t)=>s+t.amount,0);
    const p = monthTx.filter(t=>t.personId===pid && t.type==='goal_penalty').reduce((s,t)=>s+t.amount,0);
    let bestStreak=0;
    state.goals.filter(gl=>gl.participant===pid || gl.participant==='both').forEach(gl=>{ bestStreak=Math.max(bestStreak, computeStreak(gl.id, gl.participant==='both'&&gl.responsibilityType==='either'?'both':pid).current); });
    return {total:recs.length, done, pct: recs.length?Math.round(done/recs.length*100):0, g, p, bestStreak};
  };
  const c1=cmp('p1'), c2=cmp('p2');
  document.getElementById('dashCompare').innerHTML = `
    <table class="compare">
      <tr><th></th><th>${personEmoji('p1')} ${personLabel('p1')}</th><th>${personEmoji('p2')} ${personLabel('p2')}</th></tr>
      <tr><td>Metas</td><td>${c1.total}</td><td>${c2.total}</td></tr>
      <tr><td>Concluídas</td><td>${c1.done}</td><td>${c2.done}</td></tr>
      <tr><td>Aproveitamento</td><td>${c1.pct}%</td><td>${c2.pct}%</td></tr>
      <tr><td>Ganhos</td><td>${fmtMoney(c1.g)}</td><td>${fmtMoney(c2.g)}</td></tr>
      <tr><td>Penalidades</td><td>${fmtMoney(c1.p)}</td><td>${fmtMoney(c2.p)}</td></tr>
      <tr><td>Streak atual</td><td>🔥 ${c1.bestStreak}</td><td>🔥 ${c2.bestStreak}</td></tr>
    </table>`;

  // Badges
  document.getElementById('dashBadges').innerHTML = BADGE_DEFS.map(b=>{
    const unlocked = b.check();
    return `<div class="badge-tile ${unlocked?'':'locked'}"><div class="b-emoji">${b.emoji}</div><div class="b-title">${b.title}</div></div>`;
  }).join('');
}

